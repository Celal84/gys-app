{
  "name": "csidb-gys-hazirlik",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts",
    "test": "vitest run --reporter=default --reporter=json --outputFile=docs/test-results.json",
    "test:e2e": "playwright test",
    "audit:content": "node scripts/audit-content.mjs",
    "predev": "npm run verify:content && npm run verify:exams && node scripts/sync-assets.mjs",
    "prebuild": "npm run verify:content && npm run verify:exams && node scripts/sync-assets.mjs",
    "verify:content": "tsx scripts/publish-content.ts",
    "test:sources": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "serve": "node server.mjs",
    "dev:full": "npm run verify:content && node scripts/sync-assets.mjs && node scripts/dev-full.mjs",
    "verify:exams": "tsx scripts/publish-exams.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "alpinejs": "3.15.8",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.19.2",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
